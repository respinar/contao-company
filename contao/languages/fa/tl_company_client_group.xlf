      </trans-unit>
      <trans-unit id="protected_legend">
        <source>Access protection</source>
        <target>محافظت دسترسی</target>
      </trans-unit>
      <trans-unit id="title.0">
        <source>Title</source>
        <target>عنوان</target>
      </trans-unit>
      <trans-unit id="title.1">
        <source>Please enter the group title.</source>
        <target>لطفاً عنوان گروه را وارد کنید.</target>
      </trans-unit>
      <trans-unit id="overviewPage.0">
        <source>Overview page</source>
        <target>صفحه نمای کلی</target>
      </trans-unit>
      <trans-unit id="overviewPage.1">
        <source>Please choose the clients list page which will be used as the return link from the client detail page.</source>
        <target>لطفاً صفحه فهرست مشتریان را انتخاب کنید که به‌عنوان پیوند بازگشت از صفحه جزئیات مشتری استفاده خواهد شد.</target>
      </trans-unit>
