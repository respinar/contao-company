      </trans-unit>
      <trans-unit id="all.0">
        <source>Edit multiple</source>
        <target>ویرایش چندتایی</target>
      </trans-unit>
      <trans-unit id="all.1">
        <source>Edit multiple groups at once</source>
        <target>ویرایش چندین گروه به‌طور هم‌زمان</target>
