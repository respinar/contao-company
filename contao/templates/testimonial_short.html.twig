<article class="testimonial-card {{ class }}">
    <div class="quote-icon">&ldquo;</div>

    {% if quote %}
        <div class="testimonial-text">
            {{ quote|raw }}
        </div>
    {% endif %}

    <div class="testimonial-footer">
        <div class="testimonial-info">
            {% if personName %}
                <h4>{{ personName }}</h4>
            {% endif %}

            {% if position %}
                <p>
                  {{ position }}
                  {% if clientName %}
                    - <a class="testimonial-client" href="{{ clientUrl }}">{{ clientName }}</a>
                  {% endif %}
                </p>
            {% endif %}

            {% if projectTitle %}
                <a class="testimonial-project" href="{{ projectUrl }}">{{ projectTitle }}</a>
            {% endif %}
        </div>
    </div>
</article>
