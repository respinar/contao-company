{% extends '@Contao/content_element/_base.html.twig' %}

{% block content %}
    {% if backend is defined and backend %}
        <p>Project detail</p>
    {% else %}
        {{ project|raw }}
        {% if testimonial %}
            <div class="testimonial_single">
                {{ testimonial|raw }}
            </div>
        {% endif %}
        {% if overviewPageUrl %}
            <p class="back"><a href="{{ overviewPageUrl }}">Back to all projects</a></p>
        {% endif %}
    {% endif %}
{% endblock %}
