<article class="{{ class }} testimonial--full">
    {% if title %}
        <h1>{{ title }}</h1>
    {% endif %}

    <footer class="testimonial__footer">
        <p class="testimonial__person">
            {{ personName }}
            {% if position %}
                <span class="testimonial__position">{{ position }}</span>
            {% endif %}
        </p>

        {% if company %}
            <p class="testimonial__company">{{ company }}</p>
        {% endif %}
    </footer>

    {% if quote %}
        <blockquote class="testimonial__quote">
            {{ quote|raw }}
        </blockquote>
    {% endif %}

    {% if fullText %}
        <div class="testimonial__fulltext">
            {{ fullText|raw }}
        </div>
    {% endif %}

    {% if dateFormatted %}
        <time datetime="{{ date }}">{{ dateFormatted }}</time>
    {% endif %}
</article>
