{% use "@Contao/component/_figure.html.twig" %}

<div class="client-detail">

    {% if figure %}
        {% with {figure: figure} %}
            {{ block('figure_component') }}
        {% endwith %}
    {% endif %}

    <h1 class="client-name">{{ name }}</h1>

    {% if website|default %}
        <a href="{{ website }}" target="_blank" rel="noopener noreferrer" title="{{ name }}">
    {% endif %}

    {% if website|default %}
        </a>
    {% endif %}

    {% if description|default %}
        <div class="client-description">{{ description|raw }}</div>
    {% endif %}
</div>
