{
    "name": "respinar/contao-company",
    "description": "Contao Company Bundle",
    "keywords": ["contao", "bundle", "company"],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Hamid Peywasti",
            "email": "hamid@respinar.com",
            "homepage": "https://respinar.com/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/respinar/contao-company/issues",
        "source": "https://github.com/respinar/contao-company"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.13",
        "contao/news-bundle": "^5.7",
        "contao/easy-coding-standard": "^6.14",
        "contao/rector": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Respinar\\CompanyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Respinar\\CompanyBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Respinar\\CompanyBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "php-http/discovery": true,
            "contao/manager-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
